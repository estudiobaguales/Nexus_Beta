# Dominio de produccion usado para metadataBase, canonical, sitemap.xml, robots.txt y JSON-LD.
# TODO: reemplazar por el dominio real antes de producción.
NEXT_PUBLIC_SITE_URL=https://www.nexus-sports.cl

# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Secreto compartido con los webhooks de Shopify (Settings > Notifications > Webhooks).
# Server-only: NO llevar el prefijo NEXT_PUBLIC_. Usado para validar el header
# X-Shopify-Hmac-Sha256 en app/api/revalidate/route.ts.
SHOPIFY_WEBHOOK_SECRET=
